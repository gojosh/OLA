feature ss01 {
    featureNames { name "Without spurs"; };
    sub i by i.nospur;
    sub n by n.nospur;
    sub m by m.nospur;
    sub l by l.nospur;
    sub c by c.nospur;
    sub e by e.nospur;
    sub r by r.nospur;
    sub t by t.nospur;
    sub d by d.nospur;
    sub h by h.nospur;
    sub k by k.nospur;
    sub a by a.nospur;
    sub u by u.nospur;
    sub j by j.nospur;
} ss01;
feature ss02 {
    featureNames { name "Without stems and pips"; };
    sub s by s.nopips;
} ss02;
feature ss03 {
    featureNames { name "Alternate y"; };
    sub y by y.alt;
} ss03;
