{
 "method": {
  "note": "As the Lombardic's (tools/type/spacing.py), over the x-height, but with the target white set so two i's stand one minim's pitch apart (the pitch of n's stems): a textura is spaced like a fence. The pairs still off are kerned; nothing may come closer than the clearance over the whole height, ascenders and descenders included. Provisional.",
  "target_white": 57.7,
  "target_white_note": "units, held at the value set by two i's one minim's pitch apart until 2026-10-29. That measure takes the i's whole ink, spurs and mark included, so giving the i a lighter head, a top spur and a new mark would have respaced every letter (to 60.0; measured on the i without spurs, 64.7). Held, the other letters keep their spacing.",
  "depth": 120,
  "kern_threshold": 15,
  "clearance": 10,
  "word_space": 200,
  "clearance_note": "units, between heads, feet and stems in the x-height band, which in a textura this tight all but touch",
  "clearance_top_spur": 4,
  "clearance_top_spur_note": "units: how close the top spur leading into a first head (i, j, n, m, r) may come to the letter before; the letters are spaced without it. Josh, 2026-10-29, choosing from 10, 4 and touching: \"4 units clear looks good\"",
  "clearance_outside": 20,
  "clearance_outside_note": "units, above the x-height and below the baseline: at 10, d's arm leaning back over its bowl read as touching a preceding l's or h's spur at text size"
 },
 "target_white": 57.7,
