 "meaning": {
  "nib_width": "the nib's width (px)",
  "nib_angle": "the angle of the nib's edge at the heads, at the x-height line and above, rising to the right (degrees)",
  "nib_angle_foot": "the nib's angle at the feet, at the baseline and below: the pen turns evenly from the one to the other between the two lines, as Pugin's does (degrees)",
  "nib_thickness": "the nib's thickness: the width of a hairline (px)",
  "nib_light": "the nib's width in a stroke written with less pressure, as a share of its full width (c's top, e's arm, a's top bowl)",
  "top_leave": "the angle at which the concave top of c, d, e, g and s leaves the stem's top corner, rising to the right, before it steepens to the nib's own angle at the peak (degrees)",
  "fork_notch": "the split top of b, d, h, k and l, and the split bottom of q, turned upside down (and of p, until Josh drew it): how deep its notch runs below the tips' tops (px)",
  "fork_flare": "the split top: how far below the tips' tops the stem begins to widen into it (px)",
  "fork_out": "the split top: how far each tip stands out beyond the stem's edge (px)",
  "fork_tip": "the split top: the radius of each horn's rounded tip (px)",
  "fork_lean": "the split top: how far from upright each horn's outer edge runs into its tip (degrees)",
  "head": "how far right the head's stroke travels before the stem (px)",
  "head_angle": "the head stroke's slope, falling to the right (degrees)",
  "head_turn": "how far down the stem the pen settles out of its turn from the head (px)",
  "foot": "how far right the foot's stroke travels after the stem (px)",
  "foot_angle": "the foot stroke's slope, falling to the right (degrees)",
  "foot_turn": "how far up the stem the pen starts its turn into the foot (px)",
  "join": "where a foot that runs on into the next minim ends, left of that minim's stem (px; u, w). It was fitted when n's and m's heads also started this far right of the stem before; since 2026-10-29 they start clear of it, joined by a hairline, and no letter Pugin drew measures it",
  "top": "where a minim's head stroke starts: the x-height line (px on the plate)",
  "bottom": "where a minim's foot stroke ends (px on the plate); the baseline is where the points of the feet stand, below it (baseline)",
  "ascender": "where an ascender's head stroke starts (px on the plate)",
  "descender": "where a descender's stroke ends (px on the plate)"
 },
